    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT status,\n       count(*) AS events,\n       round((avg(extract(epoch FROM (updated_at - created_at))) FILTER (WHERE status = 'done'))::numeric, 1) AS avg_latency_s\nFROM events_inbox\nWHERE created_at > now() - interval '24 hours'\nGROUP BY status\nORDER BY status;",
        "options": {}
      },
      "id": "ea291dff-7a53-4760-9dbb-2c6d7ff7fe76",
      "name": "Last 24h Stats",
      "type": "n8n-nodes-base.postgres",
