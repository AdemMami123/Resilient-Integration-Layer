    {
      "parameters": {
        "jsCode": "const emails = ['amira@example.com', 'youssef@example.com', 'sara@example.com', 'karim@example.com', 'nour@example.com'];\nconst types = ['user.signed_up', 'trial.started', 'invoice.paid', 'subscription.cancelled'];\nconst stamp = Date.now();\nconst out = [];\n\nemails.forEach((email, idx) => {\n  const name = email.split('@')[0];\n  types.slice(0, 1 + (idx % 4)).forEach((type, k) => {\n    out.push({ json: { tamper: false, body: {\n      event_id: `evt_${stamp}_${idx}_${k}`, type, timestamp: new Date().toISOString(),\n      payload: { email, name, amount: type === 'invoice.paid' ? 49 : 0 }\n    }}});\n  });\n});\n\n// 1) duplicate delivery of the first event (must be ignored)\nout.push({ json: { tamper: false, body: out[0].json.body } });\n// 2) forged event with a wrong signature (must be rejected with 401)\nout.push({ json: { tamper: true, body: { event_id: `evt_${stamp}_bad`, type: 'invoice.paid', timestamp: new Date().toISOString(), payload: { email: 'attacker@example.com', name: 'attacker', amount: 9999 } } } });\n// 3) unknown event type (must end in the dead-letter queue)\nout.push({ json: { tamper: false, body: { event_id: `evt_${stamp}_unk`, type: 'unknown.event', timestamp: new Date().toISOString(), payload: { email: 'x@example.com', name: 'x' } } } });\nreturn out;"
      },
