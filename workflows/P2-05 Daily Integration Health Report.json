    {
      "parameters": {
        "jsCode": "const map = {\n  'user.signed_up': 'lead',\n  'trial.started': 'trial',\n  'invoice.paid': 'customer',\n  'subscription.cancelled': 'churned'\n};\nreturn $input.all().map(i => {\n  const e = i.json;\n  const stage = map[e.type];\n  const p = e.payload || {};\n  return { json: {\n    event_id: e.event_id,\n    attempts: e.attempts,\n    supported: !!stage && !!p.email,\n    crm: stage ? { email: p.email, name: p.name || '', stage, amount: p.amount || 0, event_id: e.event_id } : null\n  }};\n});"
      },
