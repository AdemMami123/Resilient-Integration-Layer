      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body || {};\nlet reason = null;\nif (!b.event_id || !b.type || !b.timestamp) reason = 'malformed';\nelse if (j.headers['x-signature'] !== j.computedSignature) reason = 'bad_signature';\nelse if (Math.abs(Date.now() - new Date(b.timestamp).getTime()) > 300000) reason = 'stale_timestamp';\nreturn [{ json: { valid: !reason, reason, body: b } }];"
