        0,
        384
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pairs each HTTP response with the event it belongs to (same order)\nconst src = $('Supported?').all(0);\nconst MAX_ATTEMPTS = 5;\nreturn $input.all().map((it, idx) => {\n  const s = src[idx].json;\n  const code = it.json.statusCode;\n  const ok = code >= 200 && code < 300;\n  const retryable = !ok && (!code || code === 429 || code >= 500);\n  const outcome = ok ? 'done' : (retryable && s.attempts < MAX_ATTEMPTS ? 'retry' : 'dead');\n  const delayMin = Math.pow(2, s.attempts); // exponential backoff: 2, 4, 8, 16 min\n  return { json: {\n    event_id: s.event_id,\n    status: outcome,\n    last_error: ok ? '' : `HTTP ${code || 'network error'}`,\n    next_attempt_at: new Date(Date.now() + (outcome === 'retry' ? delayMin * 60000 : 0)).toISOString(),\n    updated_at: new Date().toISOString()\n  }};\n});"
      },
      "id": "fda42da0-f772-4369-b2e4-faf86b5685de",
      "name": "Classify Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: {\n  event_id: i.json.event_id,\n  status: 'dead',\n  last_error: 'unsupported_event_type_or_missing_email',\n  next_attempt_at: new Date().toISOString(),\n  updated_at: new Date().toISOString()\n}}));"
      },
