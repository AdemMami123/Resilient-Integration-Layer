          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst total = rows.reduce((a, r) => a + Number(r.events), 0);\nconst get = s => Number((rows.find(r => r.status === s) || {}).events || 0);\nconst dead = get('dead');\nconst done = get('done');\nconst failureRate = total ? ((dead / total) * 100).toFixed(1) : '0.0';\nconst lat = (rows.find(r => r.status === 'done') || {}).avg_latency_s;\n\nconst tr = rows.map(r => `<tr><td>${r.status}</td><td>${r.events}</td><td>${r.avg_latency_s ?? '-'}</td></tr>`).join('');\nconst html = `<h2>Integration health, last 24h</h2>\n<p><b>${total}</b> events, <b>${done}</b> synced, <b>${dead}</b> dead-lettered (${failureRate}% failure rate). Average time to sync: ${lat ?? '-'} s.</p>\n<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;font-family:Arial,sans-serif'><tr><th>Status</th><th>Events</th><th>Avg latency (s)</th></tr>${tr}</table>\n${dead > 0 ? '<p><b>Action needed:</b> run the Replay Dead Letters workflow after fixing the cause.</p>' : ''}`;\n\nreturn [{ json: { subject: `Integration report: ${done}/${total} synced, ${dead} dead`, html } }];"
      },
