
## Environment variables for the Resilient application

# PostgreSQL
POSTGRES_DB=resilient
POSTGRES_USER=resilient
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_a_random_32_plus_character_secret
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Mailpit - local email testing
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Resilient settings
JOB_RADAR_TIMEZONE=Africa/Tunis
JOB_RADAR_MIN_SCORE=60